<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/block_bg"
    android:padding="24dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/block_card"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/brand_mark"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_trickle_mark"
                android:contentDescription="Trickle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Trickle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:textColor="@color/block_text" />

        </LinearLayout>

        <com.trickle.HourglassView
            android:id="@+id/hourglass"
            android:layout_width="96dp"
            android:layout_height="128dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/block_text_muted" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="56sp"
            android:textColor="@color/block_text"
            android:fontFamily="sans-serif-light"
            android:text="0:00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:textColor="@color/block_text_muted"
            android:text="Time is up here. Come back later." />

        <TextView
            android:id="@+id/btn_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:gravity="center"
            android:background="@drawable/block_button"
            android:textColor="@color/block_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:text="Ok" />

    </LinearLayout>

</LinearLayout>